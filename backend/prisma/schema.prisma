generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 📌 Enum for Exams
enum ExamType {
  MPSC
  TALATHI
  BOTH
}

// 📌 Enum for Priority
enum Priority {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

// 📌 Enum for Difficulty
enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// 📚 1. Subject Model
model Subject {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  examTags  ExamType[] 
  topics    Topic[]
  createdAt DateTime   @default(now())
}

// 📖 2. Topic Model
model Topic {
  id        Int        @id @default(autoincrement())
  name      String
  examTags  ExamType[]
  subjectId Int
  subject   Subject    @relation(fields: [subjectId], references: [id])
  subTopics SubTopic[]
}

// 📄 3. SubTopic Model
model SubTopic {
  id             Int        @id @default(autoincrement())
  name           String
  priority       Priority   @default(MEDIUM)
  difficulty     Difficulty @default(MEDIUM)
  estimatedHours Float
  revisionDays   Int[]      // e.g. [1, 3, 7, 15]
  examTags       ExamType[]
  topicId        Int
  topic          Topic      @relation(fields: [topicId], references: [id])
}
