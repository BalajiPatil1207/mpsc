generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 📌 Enum for Exams
enum ExamType {
  MPSC
  TALATHI
  BOTH
}

// 📌 Enum for Priority
enum Priority {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

// 📌 Enum for Difficulty
enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// 📚 1. Subject Model
model Subject {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  examTags  ExamType[] 
  topics    Topic[]
  createdAt DateTime   @default(now())
}

// 📖 2. Topic Model
model Topic {
  id        Int        @id @default(autoincrement())
  name      String
  examTags  ExamType[]
  subjectId Int
  subject   Subject    @relation(fields: [subjectId], references: [id])
  subTopics SubTopic[]
}

// 📄 3. SubTopic Model
model SubTopic {
  id             Int        @id @default(autoincrement())
  name           String
  priority       Priority   @default(MEDIUM)
  difficulty     Difficulty @default(MEDIUM)
  estimatedHours Float
  revisionDays   Int[]      // e.g. [1, 3, 7, 15]
  examTags       ExamType[]
  topicId        Int
  topic          Topic      @relation(fields: [topicId], references: [id])
}

// 👤 4. User Model
model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  targetExam ExamType  @default(MPSC)
  streak    Int        @default(0)
  level     Int        @default(1)
  points    Int        @default(0)
  createdAt DateTime   @default(now())
  
  // Relations
  notes     ScannedNote[]
  tests     TestSession[]
}

// 📷 5. Scanned Notes / AI Generated Docs
model ScannedNote {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  photoUrl    String?
  aiContent   String   @db.Text
  subjectId   Int?
  topicId     Int?
  createdAt   DateTime @default(now())
}

// 📝 6. Test Session (Quiz)
model TestSession {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  type        String   @default("Daily") // Daily, Mistake, MahaTest
  score       Int      @default(0)
  total       Int
  accuracy    Float    @default(0.0)
  createdAt   DateTime @default(now())
}

// ⚙️ 7. App Config (for Admin settings like Exam Date)
model AppConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}
